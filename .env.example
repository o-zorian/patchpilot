APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./data/patchpilot.db
ARTIFACT_ROOT=./artifacts
WORKSPACE_ROOT=./workspaces
LOG_LEVEL=INFO
TOOL_OUTPUT_MAX_CHARS=20000
TOOL_LIST_MAX_FILES=1000
TOOL_SEARCH_MAX_RESULTS=100
TOOL_READ_MAX_LINES=400
TOOL_MAX_FILE_BYTES=1048576

HARD_MAX_STEPS=30
HARD_MAX_INPUT_TOKENS=250000
HARD_MAX_OUTPUT_TOKENS=64000
HARD_MAX_COST_USD=1.00
HARD_MAX_WALL_TIME_SECONDS=1800
HARD_MAX_CHANGED_FILES=50
HARD_MAX_PATCH_LINES=2000
HARD_MAX_COMMAND_TIMEOUT_SECONDS=1800
HARD_MAX_CPU_LIMIT=8
HARD_MAX_MEMORY_LIMIT_MB=8192
