diff --git a/pagetoken/encode.go b/pagetoken/encode.go
--- a/pagetoken/encode.go
+++ b/pagetoken/encode.go
@@ -1,7 +1,11 @@
 package pagetoken
 
-import "encoding/base64"
+import (
+	"encoding/base64"
+	"net/url"
+)
 
 func Encode(tenant, cursor string) string {
-	return base64.RawURLEncoding.EncodeToString([]byte(tenant + ":" + cursor))
